# Semantic Scholar Academic Graph API (free key; optional but avoids tight rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Crossref needs no key. Put a real email so requests go to the faster "polite pool".
CROSSREF_MAILTO=

# Tavily Search API
TAVILY_API_KEY=

# Supabase (only needed once the database is set up)
SUPABASE_URL=
SUPABASE_KEY=
